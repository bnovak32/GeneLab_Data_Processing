// Config that specifies packaged conda yml files for each process
process {
    withName: 'PROCESS_AGILE1CH' {
        conda     = "${projectDir}/envs/R_microarray_agilent.yaml"
        container = "quay.io/nasa_genelab/gl-microarray:1.1.0"
    }
    withName: 'RUNSHEET_FROM_GLDS|RUNSHEET_FROM_ISA|VV_AGILE1CH|GENERATE_MD5SUMS|UPDATE_ISA_TABLES|GENERATE_SOFTWARE_TABLE|GENERATE_PROTOCOL' {
        conda     = "${projectDir}/envs/dp_tools.yaml"
        container = "quay.io/nasa_genelab/dp_tools:1.3.11"
    }
}
