nextflow.enable.moduleBinaries = true

params {
  /* Here GLDS and OSD accession are defined.  
  Default behavior is as follows:
  - If accessions are not set, then either runsheet or an ISA Archive MUST be supplied
  - If both accessions are set:
    - If runsheet and ISA archive are left unset, then the ISA archive will be fetched from the GeneLab API and runsheet generated from the runsheet.
    - If either runsheet or ISA archive are set, they will be used but the output directory and tags will reflect the appropriate accessions.  This is useful when processing from the OSDR but OSDR metadata is not ready as is.
    - If both runsheet and ISA archive are set, the workflow will halt.
  - If only one accession is set, then the workflow will halt.
  
  */
  osdAccession = "" // OSD Data Accession Number, e.g. OSD-367
  gldsAccession = "" // GeneLab Data Accession Number, e.g. GLDS-104

  // the location for the output from the pipeline (also includes raw data and metadata)
  resultsDir = (params.gldsAccession && params.osdAccession) ? "./${params.gldsAccession}" : "." 

  /*
  Parameters that CAN be overwritten
  */
  runsheetPath = "" // Path to a runsheet file, if not supplied, the workflow will attempt to generate one from the OSDR
  referenceStorePath = './References' // Path to custom annotation references
  biomart_attribute = "" // Must be supplied if runsheet 'Array design REF' column doesn't indicate it
  isaArchivePath = "" // Alternative to fetching the ISA archive for an associated OSD/GLDS dataset
  publish_dir_mode = "link" // method for creating publish directory.  Default here for hard link
  help = false // display help menu and exit workflow program

  /*
  Parameters that SHOULD NOT be overwritten
  */
  annotation_file_path = "https://raw.githubusercontent.com/nasa/GeneLab_Data_Processing/GL_RefAnnotTable-A_1.1.0/GeneLab_Reference_Annotations/Pipeline_GL-DPPD-7110_Versions/GL-DPPD-7110-A/GL-DPPD-7110-A_annotations.csv"
  annotation_config_path = "${projectDir}/../examples/annotations/config.csv"

  // sets the suffix for the Nextflow resource reports.
  trace_report_suffix = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')

  /*
  DEBUG related parameters, not likely useful in production
  */
  skipVV = false // if true, VV will not be performed
  skipDE = false // if true, DE will not be performed
  limit_biomart_query = 5 // if set to a value > 0, that value is the maximum number of biomart probe IDs to query
  max_flag_code = 80 // Maximum flag value allowed, exceeding this value during V&V will cause the workflow to halt
  
}