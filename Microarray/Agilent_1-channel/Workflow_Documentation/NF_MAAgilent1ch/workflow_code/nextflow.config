plugins {
  id 'nf-schema@2.7.2'
}

validation {
    help {
        enabled = true
    }
}

includeConfig 'config/default.config' // default config for NF-MAAgilent_1-channel workflow

profiles {
    // Default slurm based run mode
    // Ideally, one would fine tune the slurm config to their cluster
    slurm {
        includeConfig 'config/executor/default_slurm.config'
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
        // Address issue: https://github.com/nextflow-io/nextflow/issues/1210
        process {
          errorStrategy = { 
            task.exitStatus == 255 ? 'retry' : 'terminate' 
            }
        }
        includeConfig 'config/software/by_docker_image.config'
    }

    docker {
        singularity.enabled    = false
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
        process {
          errorStrategy = { 
            [125,127].contains(task.exitStatus) ? 'retry' : 'terminate' 
            }
        }
        includeConfig 'config/software/by_docker_image.config'
    }

    conda {
        singularity.enabled    = false
        docker.enabled         = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
        conda.enabled          = true
        conda.cacheDir         = '/Users/banovak/miniforge3/envs'
        includeConfig 'config/software/by_docker_image.config'
    }
}

manifest {
    homePage = 'https://github.com/nasa/GeneLab_Data_Processing/tree/master/Microarray/Agilent_1-channel'
    description = 'NASA GeneLab Agilent 1 Channel Microarray Workflow for Pipeline Document GL-DPPD-7112-A'
    mainScript = 'main.nf'
    defaultBranch = 'main'
    nextflowVersion = '>=25.10.6, <=26.0.0'
    version = '1.0.5'
}

timeline {
    enabled = true
    file    = "${params.resultsDir}/Resource_Usage/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "${params.resultsDir}/Resource_Usage/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "${params.resultsDir}/Resource_Usage/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = false // TODO: DISCUSS, setting up nextflow env with graphviz to output the svg diagram
    file    = "${params.resultsDir}/Resource_Usage/pipeline_dag_${params.trace_report_suffix}.svg"
}
